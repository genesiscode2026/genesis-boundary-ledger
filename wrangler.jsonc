{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genesis-boundary-ledger",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "observability": { "enabled": true }
}
